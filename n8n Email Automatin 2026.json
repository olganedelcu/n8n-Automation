    {
      "parameters": {
        "jsCode": "const subject = ($json.subject || \"\").toLowerCase();\n\n// Build a \"best effort\" text blob from whatever Gmail/n8n provides\nconst parts = [\n  $json.textPlain,\n  $json.textHtml,\n  $json.snippet,\n  $json.body,\n  $json.text,          // sometimes nodes expose this\n  $json.message,       // sometimes nodes expose this\n].filter(Boolean);\n\nconst text = (subject + \"\\n\" + parts.join(\"\\n\")).toLowerCase();\n\nconst has = (patterns) => patterns.some((p) => p.test(text));\n\n// --- Patterns (tweak freely) ---\n\nconst interviewPatterns = [\n  /\\binterview\\b/,\n  /\\bphone screen\\b/,\n  /\\btechnical screen\\b/,\n  /\\bintro call\\b/,\n  /\\bnext step\\b/,\n  /\\bnext steps\\b/,\n  /\\bschedule\\b/,\n  /\\bscheduling\\b/,\n  /\\bavailability\\b/,\n  /\\bcalendar\\b/,\n  /\\bcalendly\\b/,\n  /\\bmeeting\\b/,\n  /\\bcall\\b/,\n  /\\bconversation\\b/,\n  /\\bchat\\b/,\n  /\\bdiscussion\\b/,\n  /\\bonsite\\b/,\n  /\\bcase study\\b/,\n  /\\bhome assignment\\b/,\n];\n\n\nconst rejectionPatterns = [\n  /\\bregret to inform you\\b/,\n  /\\bwe regret\\b/,\n  /\\bunfortunately\\b/,\n  /\\bnot moving forward\\b/,\n  /\\bwon'?t be moving forward\\b/,\n  /\\bwe have decided to move forward\\b.*\\b(other|with other candidates|another candidate)\\b/,\n  /\\bother candidates\\b/,\n  /\\bnot selected\\b/,\n  /\\bposition has been filled\\b/,\n  /\\bwe will not be proceeding\\b/,\n  /\\bapplication was unsuccessful\\b/,\n];\n\nconst applicationPatterns = [\n  /\\bapplication received\\b/,\n  /\\bwe received your application\\b/,\n  /\\bThank you for your application\\b/,\n  /\\bThank you for applying to\\b/,\n  /\\bwe have received your application\\b/,\n  /\\bwe'?re pleased to confirm\\b.*\\breceived your application\\b/,\n  /\\bthanks for applying\\b/,\n  /\\bthank you for applying\\b/,\n  /\\bthank you for your application\\b/,\n  /\\bapplication confirmation\\b/,\n  /\\byour application\\b.*\\b(has been submitted|has been received|is confirmed)\\b/,\n  /\\bwe'?ll review your application\\b/,\n  /\\bour recruitment team will review\\b/,\n];\n\n// Priority order matters\nlet category = \"other\";\n\nif (has(rejectionPatterns)) category = \"rejection\";\nelse if (has(interviewPatterns)) category = \"interview\";\nelse if (has(applicationPatterns)) category = \"application\";\n\nreturn [{ json: { ...$json, category, _debugTextLength: text.length } }];\n"
      },
